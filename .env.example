# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# สร้าง key ได้ที่ https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# ไม่บังคับ
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

PORT=5000

# อ่านข้อความจากรูปภาพ / PDF สแกน
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# ลดขนาดคำขอให้ใช้ได้กับโควตาบัญชีปัจจุบัน เพิ่มได้เมื่อบัญชีรองรับ
GROQ_VISION_MAX_TOKENS=900

# ถอดเสียงไมโครโฟน
GROQ_SPEECH_MODEL=whisper-large-v3-turbo
# เปิด Flask debugger เฉพาะเมื่อต้องการพัฒนา
FLASK_DEBUG=0

# ไม่จำเป็นเมื่อใช้ OCR ใน .ocr/ จาก scripts/setup_ocr.py
# TESSERACT_CMD=/path/to/tesseract
# TESSDATA_PREFIX=/path/to/tessdata
