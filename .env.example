# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# สร้าง key ได้ที่ https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# ไม่บังคับ
GROQ_MODEL=openai/gpt-oss-120b
# เน้นความแม่นยำ; ใช้ low หากต้องการลดเวลา/โทเคน
GROQ_TRANSLATION_REASONING_EFFORT=medium
# GROQ_BASE_URL=https://api.groq.com/openai/v1

PORT=5000

# อ่านข้อความจากรูปภาพ / PDF สแกน
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# ลดขนาดคำขอให้ใช้ได้กับโควตาบัญชีปัจจุบัน เพิ่มได้เมื่อบัญชีรองรับ
GROQ_VISION_MAX_TOKENS=900

# ถอดเสียงไมโครโฟน
GROQ_SPEECH_MODEL=whisper-large-v3
# Live Chat ตรวจเทียบอีกโมเดลแบบขนาน (เพิ่ม 1 คำขอถอดเสียง/ครั้ง); เว้นว่างเพื่อปิด
GROQ_SPEECH_VERIFY_MODEL=whisper-large-v3-turbo
GROQ_CHAT_REASONING_EFFORT=medium
# ตรวจความหมายอีกรอบในข้อความเสี่ยงและ Live Chat (มีคำขอ API เพิ่ม)
SEMANTIC_REVIEW_ENABLED=1
# เปิด Flask debugger เฉพาะเมื่อต้องการพัฒนา
FLASK_DEBUG=0

# ไม่จำเป็นเมื่อใช้ OCR ใน .ocr/ จาก scripts/setup_ocr.py
# TESSERACT_CMD=/path/to/tesseract
# TESSDATA_PREFIX=/path/to/tessdata

# Optional: cross-provider review only for risky short text (negation/conditions/idioms/terms).
# Default groq preserves the existing provider. Set gemini after comparing your own examples.
TRANSLATION_REVIEW_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_REVIEW_MODEL=gemini-3.5-flash-lite
# Missing Gemini key falls back to Groq. Gemini errors keep the draft and report unavailable;
# no repeated paid calls. Restart the server after changing these settings.
